{
  "name": "canvas-mcp",
  "version": "1.0.1",
  "description": "The MCP for everything EdTech. This is a collection of Canvas LMS tools for the model context protocol, which allows you to query your courses and get help for your assignments in the AI app of your choice. Try now!",
  "main": "index.js",
  "module": "./src/index.ts",
  "type": "module",
  "bin": {
    "canvas-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "start": "node dist/index.js --port 3002",
    "dev:stdio": "tsx src/index.ts",
    "dev:shttp": "tsx src/index.ts --port 3002",
    "test": "bun test",
    "test:keep": "KEEP_ARTIFACTS=true bun test",
    "prepare": "bun run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "keywords": [
    "mcp",
    "canvas",
    "gradescope",
    "education",
    "lms"
  ],
  "author": "Aryan Keluskar",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/tough-cookie": "^4.0.5",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "tough-cookie": "^4.1.4",
    "zod": "^3.25.46"
  },
  "devDependencies": {
    "@smithery/cli": "^1.2.4",
    "@types/bun": "^1.3.2",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
