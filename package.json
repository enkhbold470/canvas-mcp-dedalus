{
	"name": "canvas-mcp",
	"version": "1.0.1",
	"description": "The MCP for everything EdTech. This is a collection of Canvas LMS tools for the model context protocol, which allows you to query your courses and get help for your assignments in the AI app of your choice. Try now!",
	"main": "index.js",
	"module": "./src/index.ts",
	"type": "module",
	"bin": {
		"canvas-mcp": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "npx @smithery/cli dev",
		"dev:watch": "tsx watch src/index.ts",
		"dev:stdio": "tsx src/index.ts --stdio",
		"dev:http": "tsx src/index.ts --http",
		"dev:build": "tsc && node dist/index.js",
		"dev:build:stdio": "tsc && node dist/index.js --stdio",
		"build": "tsc && chmod +x dist/index.js",
		"build:watch": "tsc --watch",
		"prepare": "npm run build",
		"start": "node dist/index.js",
		"start:stdio": "node dist/index.js --stdio",
		"start:http": "node dist/index.js --http",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit"
	},
	"keywords": [
		"mcp",
		"canvas",
		"gradescope",
		"education",
		"lms"
	],
	"author": "Aryan Keluskar",
	"license": "ISC",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1",
		"@types/tough-cookie": "^4.0.5",
		"cheerio": "^1.0.0-rc.12",
		"dotenv": "^16.4.5",
		"node-cache": "^5.1.2",
		"node-fetch": "^3.3.2",
		"tough-cookie": "^4.1.4",
		"zod": "^3.25.46"
	},
	"devDependencies": {
		"@smithery/cli": "^1.2.4",
		"@types/node": "^20.11.24",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.0.0",
		"tsx": "^4.19.4",
		"typescript": "^5.9.3"
	}
}
